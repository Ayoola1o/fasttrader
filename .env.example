# Default mode uses a local, synthetic market and broker.
FASTTRADER_MODE=demo
PORT=3000
# For local sign-in, set a random setup code of at least 24 characters.
# On the hosted worker, set the host, persistent data directory and bridge secret.
# FASTTRADER_SIGNUP_CODE=
# FASTTRADER_HOST=0.0.0.0
# FASTTRADER_DATA_DIR=/data/fasttrader
# WORKER_SHARED_SECRET=
# Set mode to alpaca and supply Alpaca Paper credentials to enable integration.
ALPACA_KEY=
ALPACA_SECRET=
ALPACA_FEED=iex
# Gemini takes precedence when both AI keys are set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
